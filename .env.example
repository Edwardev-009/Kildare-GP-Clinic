# Dashboard backend origin (no trailing slash, no /api/public). Leave empty for demo mode with sample times.
VITE_API_URL=https://your-dashboard-backend.vercel.app

VITE_API_URL=http://localhost:5000

# Optional Cloudflare Turnstile site key (also set TURNSTILE_ENABLED=true and TURNSTILE_SECRET on the backend)
VITE_TURNSTILE_SITE_KEY=

# Contact form (EmailJS)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
